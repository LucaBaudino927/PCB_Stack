/control/verbose 0
/run/verbose 0
/vis/verbose errors

#reset geometry after the first initialization
/run/printProgress 0

#
# Defaults:
#
#	add new geometries here
#
/detector/verboseDetConstruction false
/detector/LayerThickness 50 #um
/detector/LayerMaterial G4_Si

/detector/StackUp true
/detector/NofLayers 2
/detector/coverlayThickness 50 #um
/detector/metalThickness 50 #um
/detector/glueThickness 50 #um
/detector/dielectricThickness 50 #um
/detector/constructCoverlay true
/detector/constructMetal true
/detector/constructGlue true
/detector/constructDielectric true
/detector/coverlayMaterial G4_KAPTON
/detector/metalMaterial G4_Al
/detector/glueMaterial G4_Cu
/detector/dielectricMaterial G4_KAPTON

# Initialize kernel
/run/reinitializeGeometry
/run/geometryModified
/run/initialize

#
# Defaults:
#
#	add new settings here

/myRun/beamXPosition 0 mm
/myRun/beamYPosition -15 mm
/myRun/scanWidth 40 mm
/myRun/resolution 0.05

/generator/randomizeBeamPosition true
/gun/particle geantino

/vis/drawVolume

############# Repeat commands for visualization #############
/vis/viewer/set/viewpointVector 1 1 1
/vis/viewer/set/style wireframe
/vis/viewer/set/auxiliaryEdge true
#/vis/viewer/set/lineSegmentsPerCircle 100
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByCharge
/vis/modeling/trajectories/drawByCharge-0/default/setDrawStepPts true
/vis/modeling/trajectories/drawByCharge-0/default/setStepPtsSize 1
/vis/scene/add/axes
/vis/scene/add/eventID
/vis/scene/endOfEventAction accumulate
#/vis/ogl/set/displayListLimit 5000000
#If you want to add a scale in the viewer
/vis/scene/add/scale 30 mm
#############################################################

#/run/beamOn 30

